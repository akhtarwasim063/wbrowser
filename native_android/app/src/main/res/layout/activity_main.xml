<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_crystal"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Address bar (pill address bar with shield) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:id="@+id/addressPill"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnShield"
                style="@style/WB.Icon"
                android:layout_marginStart="2dp"
                android:contentDescription="Shields"
                android:src="@drawable/ic_shield"
                android:tint="@color/wb_green" />

            <ImageView
                android:id="@+id/ivLock"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Connection security"
                android:src="@drawable/ic_lock"
                android:tint="?attr/colorOnSurfaceVariant" />

            <EditText
                android:id="@+id/urlBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_url"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btnReload"
                style="@style/WB.Icon"
                android:layout_marginEnd="2dp"
                android:contentDescription="Reload"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="invisible"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="@android:color/transparent"
        app:trackThickness="3dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/gecko"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ListView
            android:id="@+id/suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:divider="@null"
            android:elevation="8dp"
            android:visibility="gone" />

        <!-- Shown only while a video/streaming page is playing: pop the page out into Android's
             floating mini-player (picture-in-picture), like Brave's background-play button. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnPip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_pip"
            android:contentDescription="Mini player (picture-in-picture)"
            android:visibility="gone" />

        <!-- Shown only while the app bar is hidden (theater mode); tap to bring it back. -->
        <ImageView
            android:id="@+id/btnShowBars"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#99000000"
            android:padding="9dp"
            android:src="@drawable/ic_down"
            android:tint="#FFFFFFFF"
            android:contentDescription="Show toolbar"
            android:visibility="gone" />

        <!-- Tab switcher (grid, normal / private) -->
        <FrameLayout
            android:id="@+id/tabSwitcher"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_crystal"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tabsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tabs"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPrivate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="Private"
                        app:chipIcon="@drawable/ic_private"
                        app:chipIconVisible="true" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tabGrid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="88dp" />
            </LinearLayout>

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fabNewTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:text="New tab"
                app:icon="@drawable/ic_add" />
        </FrameLayout>
    </FrameLayout>

    <!-- Find in page -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_glass_bar"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Find in page"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/findPrev"
            style="@style/WB.Icon"
            android:src="@drawable/ic_up" />

        <ImageView
            android:id="@+id/findNext"
            style="@style/WB.Icon"
            android:src="@drawable/ic_down" />

        <ImageView
            android:id="@+id/findClose"
            style="@style/WB.Icon"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Bottom toolbar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_bar"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/WB.Icon"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <ImageView
            android:id="@+id/btnForward"
            style="@style/WB.Icon"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="Forward"
            android:src="@drawable/ic_arrow_forward" />

        <ImageView
            android:id="@+id/btnHome"
            style="@style/WB.Icon"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="Home"
            android:src="@drawable/ic_home" />

        <FrameLayout
            android:id="@+id/btnTabs"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tabs">

            <TextView
                android:id="@+id/tabCount"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_tabcount"
                android:gravity="center"
                android:text="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btnMenu"
            style="@style/WB.Icon"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="Menu"
            android:src="@drawable/ic_more" />
    </LinearLayout>
</LinearLayout>
